game.exe: $(OBJS)
	-tlink padding monsdata msgs $(LIB)\c0m @u6.lnk,game.exe,,$(LIB)\CM;

.c.obj:
	tcc -I$(INCLUDE) -d -mm -p -c -Z -O $<

padding.obj: padding.c
	tcc -I$(INCLUDE) -d -mh -p -c -Z -O padding.c

monsdata.obj: monsdata.c
	tcc -I$(INCLUDE) -d -mh -p -c -Z -O monsdata.c

msgs.obj: msgs.c
	tcc -I$(INCLUDE) -d -mh -p -c -Z -O msgs.c

#osi_file.obj: osi_file.asm
#	$(TLS)\tasm200 /Mx osi_file,,;

bss.obj: bss.asm
	$(TLS)\tasm200 /Mx bss,,;

#mouse.obj: mouse.asm
#	$(TLS)\tasm200 /Mx mouse,,;

.asm.obj:
	$(AS) /Mx $<,,;
